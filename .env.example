PORT=5050
# Neon connection string (from the Neon dashboard), e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/halo?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/halo_admin
CLIENT_ORIGIN=http://localhost:4200
# Connections opened at startup so the first admin requests don't each pay the connect cost.
DB_WARM_CONNECTIONS=4
# Optional: ping the database every N minutes so connections stay open and Neon doesn't suspend.
# Leave empty on Neon's free plan (keeping the database awake uses compute hours).
DB_KEEP_WARM_MINUTES=
# Admin login for the admin panel (POST /api/auth/login). Use a strong password outside local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Secret that signs admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Payment gateway (OxaPay). Deposits need both values. PUBLIC_API_URL must be the public address of this API
# (OxaPay calls back to PUBLIC_API_URL/api/webhooks/oxapay); it can't reach localhost.
OXAPAY_MERCHANT_API_KEY=
PUBLIC_API_URL=
